{
  "name": "velora-mistral-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Démo locale minimale : chat web appelant l'API Mistral via le SDK TypeScript officiel (@mistralai/mistralai). MISTRAL_API_KEY reste côté serveur uniquement.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mistralai/mistralai": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
