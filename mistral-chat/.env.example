# Chat Mistral (démo locale) — exemple de configuration.
# Copiez ce fichier en `.env` puis renseignez vos valeurs.
# NE JAMAIS commiter de fichier `.env` contenant une vraie clé.

# Clé API Mistral — obtenue sur https://console.mistral.ai (section « API keys »).
# Lue UNIQUEMENT par le serveur (src/server.ts) : jamais envoyée au navigateur.
MISTRAL_API_KEY=changez-moi

# Modèle utilisé pour le chat (défaut : mistral-large-4)
MISTRAL_MODEL=mistral-large-4

# Port d'écoute du serveur local (défaut : 3001)
PORT=3001
