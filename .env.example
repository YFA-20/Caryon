# Velora — variables d'environnement (exemple).
# Copiez ce fichier en `.env.local` pour le développement local UNIQUEMENT.
# NE JAMAIS commiter de fichier .env contenant des valeurs réelles.
# Aucun secret n'est requis pour le fonctionnement local-first de base.

# Environnement d'exécution : development | production
NEXT_PUBLIC_APP_ENV=development

# Nom public de l'application (affiché dans l'interface)
NEXT_PUBLIC_APP_NAME=Velora

# URL publique de l'application (sans slash final) — utilisée pour le manifest PWA
# Exemple : https://velora.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Synchronisation multi-appareils (Phase 3, optionnelle) ---
# La sync est activée depuis l'interface (opt-in), pas via une variable d'env.
# Le serveur par défaut est https://sync.caryon.workers.dev (configurable dans les paramètres).
# Aucune donnée en clair n'est jamais envoyée : tout est chiffré AES-256-GCM côté client.
# NEXT_PUBLIC_SYNC_ENDPOINT=https://sync.caryon.workers.dev

# --- Déploiement Cloudflare (CI uniquement, configurés dans les secrets GitHub) ---
# CLOUDFLARE_ACCOUNT_ID=<secret GitHub Actions>
# CLOUDFLARE_API_TOKEN=<secret GitHub Actions, permissions minimales Pages>
