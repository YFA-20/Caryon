{
  "name": "velora",
  "version": "1.0.0",
  "private": true,
  "description": "Velora — Votre carrière, votre espace privé. PWA local-first de gestion de candidatures, chiffrée de bout en bout.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/update-csp-hashes.mjs",
    "build:e2e": "NEXT_PUBLIC_E2E_TEST_BUILD=1 next build",
    "postbuild:e2e": "node scripts/update-csp-hashes.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "security:audit": "npm audit --audit-level=moderate",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "icons": "node scripts/make-icons.mjs",
    "security:zod": "node scripts/check-zod-cve.mjs",
    "security:audit:prod": "npm audit --omit=dev --json | node -e \"let d=\\\"\\\";process.stdin.on(\\\"data\\\",c=>d+=c);process.stdin.on(\\\"end\\\",()=>{const a=JSON.parse(d);const v=a.vulnerabilities||{};let n=0;for(const[name,info]of Object.entries(v)){if(name===\\\"zod\\\")continue;if([\\\"high\\\",\\\"critical\\\",\\\"moderate\\\"].includes(info.severity)){console.error(name+\\\": \\\"+info.severity);n++}}process.exit(n>0?1:0)})\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@mlc-ai/web-llm": "^0.2.86",
    "argon2-browser": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "lucide-react": "^0.468.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-security": "^3.0.1",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.3.0",
    "postcss": "^8.5.31",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
